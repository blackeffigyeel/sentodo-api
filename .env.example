# ---- Application ----
NODE_ENV=development
PORT=3208
LOG_LEVEL=info
# Number of trusted reverse-proxy hops (so req.ip is the real client IP, which API key allowlisting relies on)
TRUST_PROXY=1
CORS_ORIGINS=*

# ---- Datastores ----
DATABASE_URL=postgresql://sentodo:sentodo@localhost:5432/sentodo
MONGODB_URI=mongodb://localhost:27017/sentodo
REDIS_URL=redis://localhost:6379

# ---- Security (generate long random values, e.g. `openssl rand -hex 32`) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600
# Shared secret for operators and trusted services (command centre changes)
ADMIN_SERVICE_TOKEN=change-me-to-another-long-random-string

# ---- Email (Nodemailer). Leave SMTP_HOST empty to log emails instead of sending ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sentodo MFB <no-reply@sentodo.example>

# ---- Verification ----
# Mock phone verification: any 6-digit code in this list verifies a phone number
MOCK_PHONE_CODES=123456,654321,246810,135790
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_MAX_ATTEMPTS=5

# ---- Rate limiting (swap with configuration only) ----
# token-bucket | leaky-bucket | fixed-window | sliding-window-log | sliding-window-counter
RATE_LIMIT_ALGORITHM=token-bucket
# redis (shared across instances) | memory (single process)
RATE_LIMIT_STORE=redis

# ---- Queues ----
QUEUE_CONCURRENCY=5

# ---- Testing aids (keep false in production) ----
SANDBOX_FUNDING_ENABLED=false
