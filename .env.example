# ---- Application ----
NODE_ENV=development
PORT=3208
LOG_LEVEL=info
# Number of trusted reverse-proxy hops (so req.ip is the real client IP, which API key allowlisting relies on)
TRUST_PROXY=1
CORS_ORIGINS=*

# ---- Datastores ----
# PostgreSQL: discrete fields so local instances and managed clouds (Aiven, RDS, ...)
# are configured the same way.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=sentodo
DATABASE_PASSWORD=sentodo
DATABASE_NAME=sentodo
# Flip to true only for providers that require TLS with their own CA (Aiven does).
DATABASE_SSL=false
# The provider's CA certificate — a path to a .pem file, or the inline PEM wrapped
# in double quotes (quoted newlines are fine in .env files).
# Required when DATABASE_SSL=true; ignored otherwise.
# Aiven example:
#   DATABASE_HOST=pg-979efc2-dev-sentodo-api.b.aivencloud.com
#   DATABASE_PORT=20959
#   DATABASE_USER=avnadmin
#   DATABASE_PASSWORD=<your-aiven-password>
#   DATABASE_NAME=defaultdb
#   DATABASE_SSL=true
#   DATABASE_CA_CERT=/absolute/path/to/ca.pem
DATABASE_CA_CERT=

MONGODB_URI=mongodb://localhost:27017/sentodo
REDIS_URL=redis://localhost:6379

# ---- Security (generate long random values, e.g. `openssl rand -hex 32`) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600
# Shared secret for operators and trusted services (command centre changes)
ADMIN_SERVICE_TOKEN=change-me-to-another-long-random-string

# ---- Email (Nodemailer). Leave SMTP_HOST empty to log emails instead of sending ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sentodo MFB <no-reply@sentodo.example>

# ---- Verification ----
# Mock phone verification: any 6-digit code in this list verifies a phone number
MOCK_PHONE_CODES=123456,654321,246810,135790
VERIFICATION_CODE_TTL_SECONDS=600
VERIFICATION_MAX_ATTEMPTS=5

# ---- Rate limiting (swap with configuration only) ----
# token-bucket | leaky-bucket | fixed-window | sliding-window-log | sliding-window-counter
RATE_LIMIT_ALGORITHM=token-bucket
# redis (shared across instances) | memory (single process)
RATE_LIMIT_STORE=redis

# ---- Queues ----
QUEUE_CONCURRENCY=5

# ---- Testing aids (keep false in production) ----
SANDBOX_FUNDING_ENABLED=false
